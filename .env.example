# ==============================================================================
# Menza Web (Next.js) Environment Variables Template
# Copy to .env.local for local development, or add these variables in Vercel Settings
# ==============================================================================

# Application Branding
NEXT_PUBLIC_APP_NAME="Menza Restaurant Suite"

# ASP.NET Core Live Azure Web API Endpoint (must end with /api)
NEXT_PUBLIC_API_BASE_URL=https://menzaposapi20260927220419-efbdafa3buaccge8.centralindia-01.azurewebsites.net/api

# Real-Time SignalR Order & Telemetry WebSocket Hub
NEXT_PUBLIC_SIGNALR_HUB_URL=https://menzaposapi20260927220419-efbdafa3buaccge8.centralindia-01.azurewebsites.net/hubs/order

# Azure Blob Storage CDN for Media
NEXT_PUBLIC_AZURE_BLOB_BASE_URL=https://screstdev.blob.core.windows.net/sarest/

# Security Salt Seed used for Obfuscating Internal Restaurant IDs
NEXT_PUBLIC_ENCRYPTION_SALT=MenzaSalt2026

# Customer QR Ordering Web App URL
NEXT_PUBLIC_CUSTOMER_ORDERING_BASE_URL=https://menza-order-web.vercel.app

# Payment Gateway Environment: SANDBOX or PRODUCTION
NEXT_PUBLIC_CASHFREE_ENV=SANDBOX
NEXT_PUBLIC_CASHFREE_APP_ID=your_cashfree_app_id_here

# Active Payment Gateway Selection (RAZORPAY or CASHFREE)
NEXT_PUBLIC_PAYMENT_GATEWAY=RAZORPAY
NEXT_PUBLIC_IS_RAZORPAY=true
