{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./shared/*", "../src/*"],
      "react-native": ["./shims/react-native.ts"],
      "@react-native-async-storage/async-storage": ["./shims/async-storage.ts"],
      "expo-print": ["./shims/expo-print.ts"],
      "expo-sharing": ["./shims/expo-sharing.ts"],
      "lucide-react-native": ["./node_modules/lucide-react"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "shared/presentation/screens/**/*",
    "shared/presentation/screens",
    "shared/presentation/components/**/*",
    "shared/presentation/components",
    "shared/presentation/hooks/**/*",
    "shared/presentation/hooks",
    "shared/presentation/navigation/**/*",
    "shared/presentation/navigation"
  ]
}
