{
  "expo": {
    "name": "MenzaPos",
    "slug": "MenzaAdmin",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qubenexus.menzapos",
      "infoPlist": {
        "NSCameraUsageDescription": "Menza requires camera access to capture menu item photos.",
        "NSPhotoLibraryUsageDescription": "Menza requires photo library access to upload restaurant logos and dish images.",
        "NSBluetoothAlwaysUsageDescription": "Menza requires Bluetooth to connect to thermal receipt printers.",
        "NSBluetoothPeripheralUsageDescription": "Menza requires Bluetooth to connect to thermal receipt printers."
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F7F2EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.qubenexus.menzapos",
      "versionCode": 15,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Menza requires photo library access to upload restaurant logos and dish images.",
          "cameraPermission": "Menza requires camera access to capture dish photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2",
          "android": {
            "drawable": {
              "icon": "./assets/splashscreen_logo.xml"
            }
          },
          "dark": {
            "backgroundColor": "#FAF7F2"
          }
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "afd163d4-8b32-40e7-b986-633cf548c0df"
      }
    },
    "owner": "qubenexus-private-limited"
  }
}
